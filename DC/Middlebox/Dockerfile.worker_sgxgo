FROM gramineproject/gramine:latest

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY DC/Middlebox/middlebox_sgxgo /app/middlebox_sgxgo
COPY DC/Middlebox/middlebox_sgxgo_container.manifest.template /app/middlebox_sgxgo.manifest.template
COPY DC/Middlebox/schemas /app/schemas
COPY DC/Middlebox/jwks.dat /app/jwks.dat
COPY certs_external/ /home/bonsai/dcmb/certs_external/

RUN chmod +x /app/middlebox_sgxgo \
    && mkdir -p /trace \
    && gramine-sgx-gen-private-key /app/enclave-key.pem \
    && gramine-manifest /app/middlebox_sgxgo.manifest.template /app/middlebox_sgxgo.manifest \
    && gramine-sgx-sign \
        --manifest /app/middlebox_sgxgo.manifest \
        --key /app/enclave-key.pem \
        --output /app/middlebox_sgxgo.manifest.sgx

ENV OPERATOR_MODE=warm
ENV OPERATOR_ID=operator_1
ENV OPERATOR_DEFAULT_SNI=
ENV MBX_EMIT_QUOTE=0

STOPSIGNAL SIGINT

ENTRYPOINT ["gramine-sgx", "middlebox_sgxgo"]
