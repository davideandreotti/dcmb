[libos]
entrypoint = "/middlebox"

[loader]
log_level = "debug"
insecure__use_cmdline_argv = true

[loader.env]
LD_LIBRARY_PATH = "/lib:/usr/lib:/usr/lib/x86_64-linux-gnu"
GODEBUG = "netdns=go"

[loader.env.OPERATOR_TARGET]
passthrough = true

[loader.env.OPERATOR_CERT_URL]
passthrough = true

[loader.env.MBX_EMIT_QUOTE]
passthrough = true

[loader.entrypoint]
uri = "file:/usr/local/lib/x86_64-linux-gnu/gramine/libsysdb.so"
sha256 = "64678d5b24c9b16cb35e9d4b3380ad20b3bc9911adc0f25cd52e15336ad3228b"

[fs]
mounts = [
    { path = "/lib", uri = "file:/usr/local/lib/x86_64-linux-gnu/gramine/runtime/glibc" },
    { path = "/usr/lib", uri = "file:/usr/lib" },
    { path = "/usr/lib/x86_64-linux-gnu", uri = "file:/usr/lib/x86_64-linux-gnu" },
    { path = "/etc", uri = "file:/etc" },
    { path = "/home/bonsai/dcmb/certs_external/", uri = "file:/home/bonsai/dcmb/certs_external/" },
    { type = "chroot", path = "/trace", uri = "file:/home/bonsai/dcmb/DC/Middlebox/experiments" },
    { path = "/schemas", uri = "file:schemas" },
]

[sgx]
debug = true
enclave_size = "2G"
edmm_enable = false
max_threads = 16
remote_attestation = "dcap"
file_check_policy = "allow_all_but_log"
allowed_files = [
    "file:/etc/host.conf",
    "file:/etc/resolv.conf",
    "file:/etc/ssl/certs/ca-certificates.crt",
    "file:/home/bonsai/dcmb/DC/Middlebox/experiments/",
    "file:/home/bonsai/dcmb/DC/Middlebox/tests/",
]
isvprodid = 0
isvsvn = 0
enable_stats = false
use_exinfo = false

[[sgx.trusted_files]]
uri = "file:middlebox"
sha256 = "9ea9d19a3efe65b3ef5b02a2ea7b4285d30a1536b514377ddb85b416172674ef"

