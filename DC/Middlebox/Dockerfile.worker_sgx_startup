FROM gramineproject/gramine:latest

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# This image is intentionally reserved for startup-cost experiments.
COPY DC/Middlebox/middlebox /app/middlebox
COPY DC/Middlebox/middlebox_container.manifest.template /app/middlebox.manifest.template
COPY DC/Middlebox/schemas /app/schemas
COPY DC/Middlebox/jwks.dat /app/jwks.dat
COPY certs_external/ /home/bonsai/dcmb/certs_external/

RUN chmod +x /app/middlebox \
    && mkdir -p /trace \
    && gramine-sgx-gen-private-key /app/enclave-key.pem \
    && gramine-manifest /app/middlebox.manifest.template /app/middlebox.manifest \
    && gramine-sgx-sign \
        --manifest /app/middlebox.manifest \
        --key /app/enclave-key.pem \
        --output /app/middlebox.manifest.sgx

ENV OPERATOR_MODE=warm
ENV OPERATOR_ID=operator_1
ENV OPERATOR_DEFAULT_SNI=
ENV MBX_EMIT_QUOTE=0

STOPSIGNAL SIGTERM

ENTRYPOINT ["gramine-sgx", "middlebox"]
