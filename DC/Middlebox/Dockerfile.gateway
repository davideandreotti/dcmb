FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY DC/Middlebox/middlebox_gateway /app/gateway
RUN chmod +x /app/gateway

ENV GATEWAY_BACKEND_MODE=docker
ENV DOCKER_SOCKET=/var/run/docker.sock
ENV DOCKER_WORKER_IMAGE=dcmiddlebox-worker:baseline
ENV DOCKER_WORKER_NETWORK=dcmb-middlebox-net
ENV DOCKER_MIN_READY_OPERATORS=1
ENV DOCKER_SCALE_UP_BY=1
ENV GATEWAY_CLIENT_QUEUE_SIZE=100
ENV GATEWAY_CLIENT_QUEUE_TIMEOUT_MS=500
ENV GATEWAY_CLIENT_QUEUE_RETRY_MS=1

EXPOSE 9443
EXPOSE 8088

ENTRYPOINT ["/app/gateway"]
