[libos]
entrypoint = "/middlebox"

[loader]
log_level = "debug"

[loader.env]
LD_LIBRARY_PATH = "/lib:/usr/lib:/usr/lib/x86_64-linux-gnu"
GODEBUG = "netdns=go"

[loader.entrypoint]
uri = "file:/usr/lib/x86_64-linux-gnu/gramine/libsysdb.so"
sha256 = "e6014513d79ba404b73fcb310c619ddba07da66e696398829cd4a9eb3553c6a5"

[fs]
mounts = [
    { path = "/lib", uri = "file:/usr/lib/x86_64-linux-gnu/gramine/runtime/glibc" },
    { path = "/usr/lib", uri = "file:/usr/lib" },
    { path = "/usr/lib/x86_64-linux-gnu", uri = "file:/usr/lib/x86_64-linux-gnu" },
    { path = "/etc", uri = "file:/etc" },
    { path = "/certs", uri = "file:/home/bonsai/Desktop/MasterThesis/DC/certs" },
]

[sgx]
debug = true
enclave_size = "2G"
edmm_enable = false
max_threads = 16
remote_attestation = "none"
allowed_files = [
    "file:/etc/host.conf",
    "file:/etc/resolv.conf",
    "file:/etc/ssl/certs/ca-certificates.crt",
    "file:jwks.dat",
]
isvprodid = 0
isvsvn = 0
enable_stats = false
use_exinfo = false

